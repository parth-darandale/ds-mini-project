    "/zh-cn/",
    "/zh-tw/",
    "/fr/",
    "/de/",
    "/hi/",
    "/id/",
    "/it/",
    "/ja/",
    "/ko/",
    "/pl/",
    "/pt-br/",
    "/ru/",
    "/es/",
    "/uk/",
    "/vi/",
    "/fa/"
  ],
  "output_dir": "data"
}
